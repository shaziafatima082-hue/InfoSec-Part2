<!DOCTYPE html>
<html>
<head><title>DOM XSS</title><style>body { font-family: Arial; padding: 20px; }</style></head>
<body>
    <h2>DOM-Based XSS Demo (Safe Version)</h2>
    <a href="/dashboard">Back to Dashboard</a><br><br>
    <p>Type something in the URL after the # symbol (e.g., #Hello)</p>
    <div id="output" style="border: 1px solid #ccc; padding: 10px; margin-top: 10px;"></div>
    
    <script>
        // FIXED: Using textContent instead of innerHTML to prevent execution
        var hash = decodeURIComponent(window.location.hash.substring(1));
        if (hash) {
            document.getElementById('output').textContent = "You typed: " + hash;
        }
    </script>
</body>
</html>
