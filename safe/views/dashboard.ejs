<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - Education Portal</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f9; margin: 0; padding: 20px; }
        .navbar { background: #5c6bc0; color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center; border-radius: 8px; }
        .navbar a { color: white; text-decoration: none; margin-left: 15px; font-weight: bold; }
        .content { background: white; padding: 20px; margin-top: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="navbar">
        <h2>Education Portal</h2>
        <div>
            <span>Welcome, <%= user.username %>!</span>
            <a href="/profile">Profile</a>
            <a href="/comments">Comments</a>
            <a href="/search">Search</a>
            <a href="/dom-xss">DOM XSS Demo</a>
            <a href="/login">Logout</a>
        </div>
    </div>
    <div class="content">
        <h3>Dashboard</h3>
        <p>You are logged in as <b><%= user.role %></b>.</p>
        <p>Explore the links above to test vulnerabilities.</p>
    </div>
</body>
</html>
