<!DOCTYPE html>
<html>
<head><title>Search Users</title><style>body { font-family: Arial; padding: 20px; } table { border-collapse: collapse; width: 50%; } th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }</style></head>
<body>
    <h2>Search Students</h2>
    <a href="/dashboard">Back to Dashboard</a><br><br>
    <form action="/search" method="POST">
        <input type="text" name="q" placeholder="Search by username..." required style="width: 300px; padding: 5px;">
        <button type="submit">Search</button>
    </form>
    <br>
    <% if (results !== null) { %>
        <h3>Results:</h3>
        <table>
            <tr><th>ID</th><th>Username</th><th>Role</th></tr>
            <% results.forEach(function(r) { %>
                <tr><td><%= r.id %></td><td><%= r.username %></td><td><%= r.role %></td></tr>
            <% }); %>
        </table>
    <% } %>
</body>
</html>
